---
import { getCollection } from "astro:content";
import { CldImage } from "astro-cloudinary";

interface Props {
    className?: string;
}
const { className } = Astro.props;

const campaigns = await getCollection("campaigns");

const sideCampaigns = campaigns
    .filter((c) => c.data.title.includes("Tee Yod"))
    .slice(0, 2);
const coverCampaign =
    campaigns.find((c) => c.data.title.includes("Truy tìm long diên hương")) ||
    campaigns[0];
---

<section
    id="significant-campaign"
    class:list={[
        "bg-[#0a0a0a] relative overflow-hidden h-[105svh] md:h-[120svh] w-full flex items-start justify-center pt-[6svh] md:pt-[10svh] selection:bg-neon-lime selection:text-black",
        className,
    ]}
>
    {/* Atmospheric Elements */}
    <div class="absolute inset-0 z-0 pointer-events-none">
        <div
            class="absolute top-[-10%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-neon-lime mix-blend-screen blur-[200px] opacity-[0.03] animate-pulse"
        >
        </div>
        <div
            class="absolute bottom-[-10%] right-[-10%] w-[60vw] h-[60vw] rounded-full bg-blue-900 mix-blend-screen blur-[200px] opacity-[0.05]"
        >
        </div>
        <div
            class="absolute inset-0 opacity-[0.02] mix-blend-overlay bg-[url('https://grainy-gradients.vercel.app/noise.svg')]"
        >
        </div>
    </div>
    <div class="sc-wrapper w-full h-full">
        <div class="revealers">
            <div class="revealer r-1"></div>
            <div class="revealer r-2"></div>
        </div>

        <div class="images">
            {
                campaigns.map((campaign) => (
                    <div class:list={["img", { main: campaign.data.isMain }]}>
                        <CldImage
                            src={
                                campaign.data.horizontalImage ||
                                campaign.data.posterImage
                            }
                            alt={campaign.data.title}
                        />
                    </div>
                ))
            }
        </div>

        <div class="hero-content">
            <div class="site-logo">
                <div class="logo-content">
                    <div class="word">
                        <h1>SIGNIFICANT</h1>
                    </div>
                    <div class="word">
                        <h1>CAMPAIGNS</h1>
                    </div>
                </div>
            </div>

            <div class="bottom-flex-row">
                <div class="col-small">
                    <div class="line mb-4">
                        <p
                            class="section-label uppercase font-mono text-[11px] font-medium text-white m-0"
                        >
                            Highlight Campaigns
                        </p>
                    </div>
                </div>

                <div class="col-medium images-col">
                    {
                        sideCampaigns.map((campaign) => (
                            <div class="line w-full">
                                <CldImage
                                    class="info-img w-full h-full object-cover"
                                    src={
                                        campaign.data.horizontalImage ||
                                        campaign.data.posterImage
                                    }
                                    alt={campaign.data.title}
                                />
                            </div>
                        ))
                    }
                </div>

                <div class="col-large">
                    <div class="cover-img rounded-lg overflow-hidden">
                        {
                            coverCampaign && (
                                <CldImage
                                    class="w-full h-full object-cover"
                                    src={
                                        coverCampaign.data.horizontalImage ||
                                        coverCampaign.data.posterImage
                                    }
                                    alt={coverCampaign.data.title}
                                />
                            )
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .sc-wrapper {
            width: 95%;
            max-width: 90rem;
            height: 85svh;
            margin: auto;
            border-radius: 2.5rem;
            position: relative;
            overflow: hidden;
            background: #000;
            box-shadow:
                inset 0 0 100px rgba(0, 0, 0, 0.8),
                0 30px 60px rgba(0, 0, 0, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.05);
            color: #fff;
            font-family: "PP Neue Montreal", sans-serif;
            z-index: 10;
        }

        .revealers {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: row;
            z-index: 20;
        }

        .revealer {
            flex: 1;
            height: 100%;
            background-color: #030303;
            clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%);
            position: relative;
            box-shadow: inset 0 0 50px rgba(0, 0, 0, 0.8);
            border-left: 1px solid rgba(255, 255, 255, 0.03);
            border-right: 1px solid rgba(255, 255, 255, 0.03);
        }

        .revealer::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: repeating-linear-gradient(
                90deg,
                transparent,
                transparent 4px,
                rgba(255, 255, 255, 0.02) 4px,
                rgba(255, 255, 255, 0.02) 8px
            );
            z-index: 1;
        }

        .images {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100%;
            height: 100%;
            transform-origin: center center;
            will-change: transform;
        }

        .img {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(1.5);
            width: auto;
            height: 100%;
            aspect-ratio: 16/9;
            visibility: visible;
            will-change: transform;
            opacity: 0;
        }

        :global(.img img) {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .img:first-child {
            opacity: 1;
        }

        .hero-content {
            position: relative;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        .site-logo {
            position: absolute;
            top: 3vw;
            left: 3vw;
            display: flex;
            gap: 1.5vw;
            align-items: flex-start;
            flex-direction: column;
            z-index: 10;
        }

        .logo-content {
            display: flex;
            flex-direction: column;
        }

        .site-logo h1 {
            color: #fff;
            font-size: clamp(3rem, 5.5vw, 7rem);
            font-weight: 900;
            line-height: 0.85;
            letter-spacing: -0.02em;
            text-transform: uppercase;
            margin: 0;
        }

        .logo-content .word:nth-child(2) h1 {
            background: linear-gradient(to right, #ffffff, #666666);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .site-logo .word p {
            margin: 0;
            font-size: clamp(0.9rem, 1vw, 1.2rem);
            font-weight: 500;
            letter-spacing: 0.15em;
            color: rgba(255, 255, 255, 0.7);
            text-transform: uppercase;
        }

        /* FLEXBOX LAYOUT */
        .bottom-flex-row {
            position: absolute;
            bottom: 2em;
            left: 2em;
            right: 2em;
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 2vw;
            z-index: 10;
            pointer-events: none;
        }
        .bottom-flex-row > * {
            pointer-events: auto;
        }

        .col-small {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
        }

        .col-medium {
            flex: 1.5;
            display: flex;
            flex-direction: column;
            gap: 1vw;
            justify-content: flex-end;
        }

        .col-large {
            flex: 2.5;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
        }

        .images.stacked-container {
            position: relative;
            transform: none;
            top: auto;
            left: auto;
            width: 100%;
            height: auto;
            display: flex;
            flex-direction: column-reverse; /* Usually stack upwards */
            gap: 1vw;
        }

        .img.stacked {
            position: relative;
            width: 100%;
            height: auto;
            aspect-ratio: 16/9;
            transform: none;
            top: auto;
            left: auto;
            opacity: 1;
            border-radius: 8px;
            overflow: hidden;
        }
        :global(.img.stacked img) {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .cover-img {
            position: relative;
            width: 100%;
            height: auto;
            aspect-ratio: 16/9;
            clip-path: polygon(0 100%, 100% 100%, 100% 100%, 0 100%);
        }

        :global(.cover-img img) {
            filter: saturate(0);
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .images-col .line {
            width: 100%;
            height: auto;
            aspect-ratio: 16/9;
        }

        :global(.info-img) {
            border-radius: 10px;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: translateY(150%);
            will-change: transform;
        }

        .word,
        .line {
            clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
        }

        .word h1,
        .word p,
        .line p {
            position: relative;
            will-change: transform;
            transform: translateY(100%);
        }

        .word p {
            display: block;
        }

        @media (max-width: 1000px) {
            .sc-wrapper {
                width: 94%;
                height: 84%;
                border-radius: 2.4%;
                background: linear-gradient(180deg, #050505 0%, #000 100%);
                border: 1px solid rgba(255, 255, 255, 0.08);
            }

            .hero-content {
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 6% 4%;
            }

            .site-logo {
                position: relative;
                top: auto;
                left: auto;
                gap: 1.5%;
                width: 100%;
            }

            .site-logo h1 {
                font-size: clamp(2.2rem, 12vw, 3.5rem);
                line-height: 0.85;
                letter-spacing: -0.04em;
            }

            .site-logo .word p {
                font-size: 0.7rem;
                letter-spacing: 0.12em;
                opacity: 0.6;
                margin-top: 0.5rem;
            }

            .bottom-flex-row {
                position: relative;
                left: auto;
                right: auto;
                bottom: auto;
                gap: 2.5%;
                align-items: stretch;
                flex-direction: column;
                width: 100%;
            }

            .col-small {
                flex: 0 0 auto;
                width: 100%;
            }

            .col-medium {
                flex: 0 0 auto;
                width: 100%;
                gap: 2%;
                display: grid;
                grid-template-columns: 49% 49%;
                justify-content: space-between;
            }

            .col-large {
                flex: 0 0 auto;
                width: 100%;
            }

            .section-label {
                font-size: 10px !important;
                letter-spacing: 0.1em;
                margin-bottom: 0.5rem;
            }

            .line.mb-4 {
                margin-bottom: 0.5rem;
            }

            .images-col .line {
                width: 100%;
                aspect-ratio: 16/10.5;
                border-radius: 0.75rem;
                overflow: hidden;
            }

            .images-col .line:nth-child(n + 3) {
                display: none;
            }

            .cover-img {
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            }

            :global(.info-img) {
                border-radius: 0.75rem;
            }

            :global(.img) {
                transform: translate(-50%, -50%) scale(1.1);
            }

            /* Mobile: show all stacked campaign images as a clean 3x2 grid */
            .col-small .images.stacked-container {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 2%;
                width: 100%;
            }

            .col-small .img.stacked {
                width: 100%;
                aspect-ratio: 3 / 4;
                border-radius: 0.6rem;
            }

            /* Prevent duplicated image areas from crowding/overlapping the layout */
            .col-medium,
            .col-large {
                display: none;
            }
        }
    </style>

    <script>
        import { gsap } from "gsap";
        import { CustomEase, Flip, ScrollTrigger } from "gsap/all";

        document.addEventListener("DOMContentLoaded", () => {
            const initSignificantCampaign = () => {
                gsap.registerPlugin(Flip, CustomEase, ScrollTrigger);
                CustomEase.create(
                    "hop",
                    "M0,0 C0.355,0.022 0.448,0.079 0.5,0.5 0.542,0.846 0.615,1 1,1",
                );
                CustomEase.create(
                    "hop2",
                    "M0,0 C0.078,0.617 0.114,0.716 0.255,0.828 0.373,0.922 0.561,1 1,1",
                );

                const mainTl = gsap.timeline({
                    scrollTrigger: {
                        trigger: "#significant-campaign",
                        start: "top 80%",
                        once: true,
                    },
                });
                const revealer = gsap.timeline();
                const scaleTl = gsap.timeline();

                revealer
                    .to(".r-1", {
                        clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)",
                        duration: 1.8,
                        ease: "power4.inOut",
                    })
                    .to(
                        ".r-2",
                        {
                            clipPath:
                                "polygon(100% 0%, 100% 0%, 100% 100%, 100% 100%)",
                            duration: 1.8,
                            ease: "power4.inOut",
                        },
                        "<",
                    );

                scaleTl.to(".img:first-child", {
                    scale: 1,
                    duration: 1.5,
                    ease: "power4.inOut",
                });

                const images = document.querySelectorAll(
                    ".img:not(:first-child)",
                );
                images.forEach((image) => {
                    scaleTl.to(
                        image,
                        {
                            opacity: 1,
                            scale: 1,
                            duration: 0.7,
                            ease: "power3.out",
                        },
                        ">-0.5",
                    );
                });

                mainTl
                    .add(revealer)
                    .add(scaleTl, "-=1.25")
                    .add(() => {
                        document
                            .querySelectorAll(".img:not(.main)")
                            .forEach((image) => {
                                image.remove();
                            });

                        const state = Flip.getState(".main, .images");

                        const imagesContainer =
                            document.querySelector(".images");
                        const colSmall = document.querySelector(".col-small");
                        if (imagesContainer && colSmall) {
                            colSmall.appendChild(imagesContainer);
                            imagesContainer.classList.add("stacked-container");
                        }

                        document
                            .querySelectorAll(".main")
                            .forEach((image, index) => {
                                image.classList.add("stacked");
                                if (image instanceof HTMLElement) {
                                    image.style.order = index.toString();
                                }
                                gsap.set(image, {
                                    clearProps: "transform, top, left",
                                });
                            });

                        Flip.from(state, {
                            duration: 2,
                            ease: "hop",
                            absolute: true,
                            nested: true,
                            stagger: {
                                amount: -0.3,
                            },
                        });
                    })
                    .to(".word h1, .word p, .line p, .info-img", {
                        y: 0,
                        duration: 3,
                        ease: "hop2",
                        stagger: 0.1,
                        delay: 1.25,
                    })
                    .to(".cover-img", {
                        clipPath: "polygon(0 100%, 100% 100%, 100% 0%, 0% 0%)",
                        duration: 1.5,
                        ease: "hop",
                        delay: -4.75,
                    });
            };

            let isInitialized = false;
            const tryInit = () => {
                if (isInitialized) return;

                const splashScreen = document.getElementById("lh-splash");
                const prompt = document.getElementById("landscape-prompt");
                const isPromptActive =
                    prompt &&
                    window.getComputedStyle(prompt).display !== "none";

                if (!splashScreen && !isPromptActive) {
                    isInitialized = true;
                    initSignificantCampaign();
                }
            };

            // Attempt to initialize immediately if possible
            tryInit();

            // If blocked, wait for relevant events
            if (!isInitialized) {
                window.addEventListener(
                    "splashComplete",
                    () => setTimeout(tryInit, 50),
                    { once: true },
                );
                window
                    .matchMedia(
                        "(max-width: 850px) and (orientation: portrait)",
                    )
                    .addEventListener("change", (e) => {
                        if (!e.matches) setTimeout(tryInit, 50);
                    });
            }
        });
    </script>
</section>
