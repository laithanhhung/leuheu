---
import { getCollection } from "astro:content";
import { CldImage } from "astro-cloudinary";

interface Props {
    className?: string;
}
const { className } = Astro.props;

const campaigns = await getCollection("campaigns");

const sideCampaigns = campaigns
    .filter((c) => c.data.title.includes("Tee Yod"))
    .slice(0, 2);
const coverCampaign =
    campaigns.find((c) => c.data.title.includes("Truy tìm long diên hương")) ||
    campaigns[0];
---

<section
    id="significant-campaign"
    class:list={[
        "bg-neon-lime relative overflow-hidden h-screen w-full flex items-center justify-center",
        className,
    ]}
>
    <div class="sc-wrapper w-full h-full">
        <div class="revealers">
            <div class="revealer r-1"></div>
            <div class="revealer r-2"></div>
        </div>

        <div class="images">
            {
                campaigns.map((campaign) => (
                    <div class:list={["img", { main: campaign.data.isMain }]}>
                        <CldImage
                            src={
                                campaign.data.horizontalImage ||
                                campaign.data.posterImage
                            }
                            alt={campaign.data.title}
                        />
                    </div>
                ))
            }
        </div>

        <div class="hero-content">
            <div class="site-logo">
                <div class="logo-content">
                    <div class="word">
                        <h1>SIGNIFICANT</h1>
                    </div>
                    <div class="word">
                        <h1>CAMPAIGNS</h1>
                    </div>
                </div>
                <div class="word">
                    <p>#leuheu with partners</p>
                </div>
            </div>

            <div class="bottom-flex-row">
                <div class="col-small">
                    <div class="line mb-4">
                        <p
                            class="section-label uppercase font-mono text-[11px] font-medium text-white m-0"
                        >
                            Highlight Campaigns
                        </p>
                    </div>
                </div>

                <div class="col-medium images-col">
                    {
                        sideCampaigns.map((campaign) => (
                            <div class="line w-full">
                                <CldImage
                                    class="info-img w-full h-full object-cover"
                                    src={
                                        campaign.data.horizontalImage ||
                                        campaign.data.posterImage
                                    }
                                    alt={campaign.data.title}
                                />
                            </div>
                        ))
                    }
                </div>

                <div class="col-large">
                    <div class="cover-img rounded-lg overflow-hidden">
                        {
                            coverCampaign && (
                                <CldImage
                                    class="w-full h-full object-cover"
                                    src={
                                        coverCampaign.data.horizontalImage ||
                                        coverCampaign.data.posterImage
                                    }
                                    alt={coverCampaign.data.title}
                                />
                            )
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .sc-wrapper {
            width: 95%;
            max-width: 80rem;
            height: 90svh;
            margin: auto;
            border-radius: 2rem;
            position: relative;
            overflow: hidden;
            background:
                radial-gradient(
                    circle at top right,
                    rgba(199, 249, 0, 0.15),
                    transparent 50%
                ),
                radial-gradient(
                    circle at bottom left,
                    rgba(199, 249, 0, 0.1),
                    transparent 50%
                ),
                linear-gradient(135deg, #0a0a0a 0%, #000000 100%);
            box-shadow:
                inset 0 0 150px rgba(0, 0, 0, 0.9),
                0 20px 50px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(199, 249, 0, 0.2);
            color: #fff;
            font-family: "PP Neue Montreal", sans-serif;
        }

        .revealers {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: row;
            z-index: 20;
        }

        .revealer {
            flex: 1;
            height: 100%;
            background-color: #030303;
            clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%);
            position: relative;
            box-shadow: inset 0 0 50px rgba(0, 0, 0, 0.8);
            border-left: 1px solid rgba(255, 255, 255, 0.03);
            border-right: 1px solid rgba(255, 255, 255, 0.03);
        }

        .revealer::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: repeating-linear-gradient(
                90deg,
                transparent,
                transparent 4px,
                rgba(255, 255, 255, 0.02) 4px,
                rgba(255, 255, 255, 0.02) 8px
            );
            z-index: 1;
        }

        .images {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100%;
            height: 100%;
            transform-origin: center center;
            will-change: transform;
        }

        .img {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(1.5);
            width: auto;
            height: 100%;
            aspect-ratio: 16/9;
            visibility: visible;
            will-change: transform;
            opacity: 0;
        }

        :global(.img img) {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .img:first-child {
            opacity: 1;
        }

        .hero-content {
            position: relative;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        .site-logo {
            position: absolute;
            top: 3vw;
            left: 3vw;
            display: flex;
            gap: 1.5vw;
            align-items: flex-start;
            flex-direction: column;
            z-index: 10;
        }

        .logo-content {
            display: flex;
            flex-direction: column;
        }

        .site-logo h1 {
            color: #fff;
            font-size: clamp(3rem, 5.5vw, 7rem);
            font-weight: 900;
            line-height: 0.85;
            letter-spacing: -0.02em;
            text-transform: uppercase;
            margin: 0;
        }

        .logo-content .word:nth-child(2) h1 {
            background: linear-gradient(to right, #ffffff, #666666);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .site-logo .word p {
            margin: 0;
            font-size: clamp(0.9rem, 1vw, 1.2rem);
            font-weight: 500;
            letter-spacing: 0.15em;
            color: rgba(255, 255, 255, 0.7);
            text-transform: uppercase;
        }

        /* FLEXBOX LAYOUT */
        .bottom-flex-row {
            position: absolute;
            bottom: 2em;
            left: 2em;
            right: 2em;
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 2vw;
            z-index: 10;
            pointer-events: none;
        }
        .bottom-flex-row > * {
            pointer-events: auto;
        }

        .col-small {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
        }

        .col-medium {
            flex: 1.5;
            display: flex;
            flex-direction: column;
            gap: 1vw;
            justify-content: flex-end;
        }

        .col-large {
            flex: 2.5;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
        }

        .images.stacked-container {
            position: relative;
            transform: none;
            top: auto;
            left: auto;
            width: 100%;
            height: auto;
            display: flex;
            flex-direction: column-reverse; /* Usually stack upwards */
            gap: 1vw;
        }

        .img.stacked {
            position: relative;
            width: 100%;
            height: auto;
            aspect-ratio: 16/9;
            transform: none;
            top: auto;
            left: auto;
            opacity: 1;
            border-radius: 8px;
            overflow: hidden;
        }
        :global(.img.stacked img) {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .cover-img {
            position: relative;
            width: 100%;
            height: auto;
            aspect-ratio: 16/9;
            clip-path: polygon(0 100%, 100% 100%, 100% 100%, 0 100%);
        }

        :global(.cover-img img) {
            filter: saturate(0);
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .images-col .line {
            width: 100%;
            height: auto;
            aspect-ratio: 16/9;
        }

        :global(.info-img) {
            border-radius: 10px;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: translateY(150%);
            will-change: transform;
        }

        .word,
        .line {
            clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
        }

        .word h1,
        .word p,
        .line p {
            position: relative;
            will-change: transform;
            transform: translateY(100%);
        }

        .word p {
            display: block;
        }
    </style>

    <script>
        import { gsap } from "gsap";
        import { CustomEase, Flip, ScrollTrigger } from "gsap/all";

        document.addEventListener("DOMContentLoaded", () => {
            const initSignificantCampaign = () => {
                gsap.registerPlugin(Flip, CustomEase, ScrollTrigger);
                CustomEase.create(
                    "hop",
                    "M0,0 C0.355,0.022 0.448,0.079 0.5,0.5 0.542,0.846 0.615,1 1,1",
                );
                CustomEase.create(
                    "hop2",
                    "M0,0 C0.078,0.617 0.114,0.716 0.255,0.828 0.373,0.922 0.561,1 1,1",
                );

                const mainTl = gsap.timeline({
                    scrollTrigger: {
                        trigger: "#significant-campaign",
                        start: "bottom 100%",
                        onEnter: () => {
                            if (window.lenis) window.lenis.stop();
                        },
                    },
                });
                const revealer = gsap.timeline();
                const scaleTl = gsap.timeline();

                revealer
                    .to(".r-1", {
                        clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)",
                        duration: 1.8,
                        ease: "power4.inOut",
                    })
                    .to(
                        ".r-2",
                        {
                            clipPath:
                                "polygon(100% 0%, 100% 0%, 100% 100%, 100% 100%)",
                            duration: 1.8,
                            ease: "power4.inOut",
                        },
                        "<",
                    );

                scaleTl.to(".img:first-child", {
                    scale: 1,
                    duration: 1.5,
                    ease: "power4.inOut",
                });

                const images = document.querySelectorAll(
                    ".img:not(:first-child)",
                );
                images.forEach((image) => {
                    scaleTl.to(
                        image,
                        {
                            opacity: 1,
                            scale: 1,
                            duration: 0.7,
                            ease: "power3.out",
                        },
                        ">-0.5",
                    );
                });

                mainTl
                    .add(revealer)
                    .add(scaleTl, "-=1.25")
                    .add(() => {
                        document
                            .querySelectorAll(".img:not(.main)")
                            .forEach((image) => {
                                image.remove();
                            });

                        const state = Flip.getState(".main, .images");

                        const imagesContainer =
                            document.querySelector(".images");
                        const colSmall = document.querySelector(".col-small");
                        if (imagesContainer && colSmall) {
                            colSmall.appendChild(imagesContainer);
                            imagesContainer.classList.add("stacked-container");
                        }

                        document
                            .querySelectorAll(".main")
                            .forEach((image, index) => {
                                image.classList.add("stacked");
                                if (image instanceof HTMLElement) {
                                    image.style.order = index.toString();
                                }
                                gsap.set(image, {
                                    clearProps: "transform, top, left",
                                });
                            });

                        Flip.from(state, {
                            duration: 2,
                            ease: "hop",
                            absolute: true,
                            nested: true,
                            stagger: {
                                amount: -0.3,
                            },
                        });
                    })
                    .to(".word h1, .word p, .line p, .info-img", {
                        y: 0,
                        duration: 3,
                        ease: "hop2",
                        stagger: 0.1,
                        delay: 1.25,
                    })
                    .to(".cover-img", {
                        clipPath: "polygon(0 100%, 100% 100%, 100% 0%, 0% 0%)",
                        duration: 1.5,
                        ease: "hop",
                        delay: -4.75,
                        onComplete: () => {
                            if (window.lenis) window.lenis.start();
                        },
                    });
            };

            let isInitialized = false;
            const tryInit = () => {
                if (isInitialized) return;

                const splashScreen = document.getElementById("lh-splash");
                const prompt = document.getElementById("landscape-prompt");
                const isPromptActive = prompt && window.getComputedStyle(prompt).display !== "none";

                if (!splashScreen && !isPromptActive) {
                    isInitialized = true;
                    initSignificantCampaign();
                }
            };

            // Attempt to initialize immediately if possible
            tryInit();

            // If blocked, wait for relevant events
            if (!isInitialized) {
                window.addEventListener("splashComplete", () => setTimeout(tryInit, 50), { once: true });
                window.matchMedia("(max-width: 850px) and (orientation: portrait)").addEventListener("change", (e) => {
                    if (!e.matches) setTimeout(tryInit, 50);
                });
            }
        });
    </script>
</section>
