---
import type { CollectionEntry } from "astro:content";

import { CldImage } from "astro-cloudinary";

interface Props {
    campaign: CollectionEntry<"campaigns">["data"];
    className?: string;
}

const { campaign, className = "" } = Astro.props;
---

<div
    class={`p-6 xs:p-8 md:p-12 lg:p-16 relative flex flex-col justify-end overflow-hidden ${className} text-white`}
    style={{
        boxShadow: "0 -20px 50px rgba(0,0,0,0.5)"
    }}
>
    {/* Cinematic Full Screen Background Image */}
    <div class="absolute inset-0 z-0">
        <CldImage
            src={campaign.horizontalImage || campaign.posterImage}
            alt={campaign.title}
            width={1920}
            height={1080}
            crop="fill"
            class="w-full h-full object-cover"
        />
        {/* Gradients to ensure perfect text readability */}
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/90 to-transparent"></div>
        <div class="absolute inset-0 bg-black/20"></div>
    </div>

    {/* Content Wrapper */}
    <div class="relative z-10 w-full flex flex-col lg:flex-row gap-8 xs:gap-12 items-end justify-between">
        
        {/* Main Content (Title, Desc, Stats) */}
        <div class="w-full lg:w-7/12 flex flex-col">
            {/* Badge */}
            <div class="flex justify-start mb-4 xs:mb-6">
                <span
                    class="bg-neon-lime text-black px-4 xs:px-6 py-1.5 xs:py-2 rounded-full font-bold uppercase text-xs xs:text-sm md:text-base tracking-wider inline-block shadow-lg"
                >
                    {campaign.badge || "Campaign"}
                </span>
            </div>

            <h3 class="text-4xl xs:text-5xl md:text-6xl lg:text-7xl font-black mb-4 xs:mb-6 uppercase leading-tight text-white drop-shadow-2xl">
                {campaign.title}
            </h3>

            <ul class="space-y-3 mb-8">
                {
                    campaign.description.map((desc) => (
                        <li class="flex items-start gap-3 text-sm xs:text-base md:text-xl font-medium opacity-95 drop-shadow-md">
                            <span class="text-neon-lime mt-2 text-[0.6rem] xs:text-xs drop-shadow-sm">
                                ●
                            </span>
                            <span class="leading-relaxed">{desc}</span>
                        </li>
                    ))
                }
            </ul>

            {/* Stats Pills */}
            <div class="flex flex-wrap gap-4 mb-4 lg:mb-0">
                {
                    campaign.mainStat && (
                        <div class="bg-gradient-to-r from-neon-lime to-green-500 text-black px-5 xs:px-8 py-3 xs:py-4 rounded-xl font-black text-lg xs:text-2xl shadow-xl transform -skew-x-6 border border-neon-lime/50">
                            <span class="skew-x-6 inline-block">
                                {campaign.mainStat}
                            </span>
                        </div>
                    )
                }
                {
                    campaign.secondaryStat && (
                        <div class="bg-black/60 backdrop-blur-md text-neon-lime px-5 xs:px-8 py-3 xs:py-4 rounded-xl font-black text-lg xs:text-2xl shadow-xl border border-neon-lime/40">
                            {campaign.secondaryStat}
                        </div>
                    )
                }
            </div>
        </div>

        {/* Cinematic Gallery */}
        <div class="w-full lg:w-5/12 shrink-0 max-w-full z-20">
            <div class="horizontal-gallery-wrapper overflow-x-auto w-full hide-scrollbar [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none] pb-4 pt-4">
                <div class="horizontal-gallery-track flex gap-4 sm:gap-6 w-max items-center">
                    {campaign.galleryImages.map((img) => (
                        <div class="relative w-[140px] sm:w-[180px] lg:w-[220px] shrink-0 aspect-[2/3] sm:aspect-[3/4] overflow-hidden group cursor-pointer shadow-[0_10px_30px_rgba(0,0,0,0.8)] transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] hover:scale-110 hover:z-30 hover:shadow-[0_20px_50px_rgba(0,0,0,0.9)]">
                            <CldImage
                                src={img}
                                alt="Gallery"
                                width={300}
                                height={450}
                                crop="fill"
                                class="w-full h-full object-cover transform scale-[1.02] group-hover:scale-[1.08] transition-transform duration-1000 ease-out"
                            />
                            {/* Cinematic film grain and vignette overlay */}
                            <div class="absolute inset-0 shadow-[inset_0_0_30px_rgba(0,0,0,0.6)] pointer-events-none group-hover:shadow-[inset_0_0_15px_rgba(0,0,0,0.3)] transition-shadow duration-700"></div>
                            <div class="absolute inset-0 mix-blend-overlay opacity-10 bg-gradient-to-tr from-blue-900 to-amber-600 pointer-events-none group-hover:opacity-30 transition-opacity duration-700"></div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</div>
