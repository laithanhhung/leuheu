---
import { getEntry } from "astro:content";
import { CldImage } from "astro-cloudinary";
import { creators } from "../data/creators";

const statsEntry = await getEntry("sections", "stats");
const { data } = statsEntry!;
---

<section
    class="stats-section text-white py-12 xs:py-16 3xl:py-24 px-4 md:px-8 3xl:px-16 relative"
    style="background: linear-gradient(to bottom, #c7f900 0%, #8aa800 25%, #1e2800 55%, #000000 85%)"
>
    <div class="max-w-6xl 3xl:max-w-8xl mx-auto">
        <h2
            class="heading text-3xl xs:text-4xl md:text-6xl 3xl:text-8xl font-black mb-8 xs:mb-12 3xl:mb-20 uppercase"
        >
            {data.title}
            <span class="text-black">{data.subtitle}</span>
        </h2>

        <div
            class="container mx-auto grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 xs:gap-4 3xl:gap-8 mb-12 xs:mb-16 3xl:mb-24"
        >
            {
                creators.map((c) => (
                    <div class="card bg-card-gray rounded-xl 3xl:rounded-2xl p-3 xs:p-4 3xl:p-6 flex flex-col items-center text-center hover:bg-white hover:text-black transition-colors duration-300 cursor-pointer group">
                        <CldImage
                            src={c.img}
                            alt={c.name}
                            width={100}
                            height={100}
                            class="w-20 h-20 xs:w-24 xs:h-24 md:w-28 md:h-28 3xl:w-32 3xl:h-32 shrink-0 object-cover rounded-full mb-3 3xl:mb-6 border-2 border-neon-lime group-hover:border-black"
                        />
                        <p class="font-bold text-xs xs:text-sm 3xl:text-xl truncate w-full">
                            {c.name}
                        </p>
                        <p class="text-[0.6rem] xs:text-xs 3xl:text-base text-gray-400 group-hover:text-gray-600">
                            {c.followers} followers
                        </p>
                        <p class="text-[0.6rem] xs:text-xs 3xl:text-base text-gray-400 group-hover:text-gray-600">
                            {c.likes} likes
                        </p>
                    </div>
                ))
            }
        </div>

        <div
            class="stats-container flex flex-col md:flex-row gap-6 xs:gap-8 3xl:gap-16 items-center"
        >
            <div
                class="bg-card-gray rounded-[1.5rem] xs:rounded-[2rem] 3xl:rounded-[3rem] p-6 xs:p-8 3xl:p-12 flex-1 w-full flex items-center justify-between border border-gray-800"
            >
                <div>
                    {
                        data.stats?.map((stat) => (
                            <>
                                <p class="text-neon-lime text-base xs:text-lg 3xl:text-2xl font-bold">
                                    {stat.label}
                                </p>
                                <p class="text-3xl xs:text-4xl md:text-5xl 3xl:text-7xl font-black">
                                    {stat.value}{" "}
                                    <span class="text-white text-lg xs:text-2xl 3xl:text-4xl font-normal">
                                        followers
                                    </span>
                                </p>
                            </>
                        ))
                    }
                </div>
                <div class="text-neon-lime text-5xl xs:text-6xl 3xl:text-8xl">
                    ✦
                </div>
            </div>

            <div
                class="bg-neon-lime text-black rounded-[1.5rem] xs:rounded-[2rem] 3xl:rounded-[3rem] p-6 xs:p-8 3xl:p-12 flex-1 w-full flex items-center justify-center text-center"
            >
                <div>
                    <p
                        class="text-4xl xs:text-5xl md:text-7xl 3xl:text-9xl font-black"
                    >
                        {data.extraData?.stat2Value}<span
                            class="text-xl xs:text-2xl 3xl:text-4xl align-top text-black/50"
                            >+</span
                        >
                    </p>
                    <p class="font-bold text-base xs:text-lg 3xl:text-3xl">
                        {data.extraData?.stat2Label}
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
