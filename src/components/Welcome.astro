---
import { Image } from "astro:assets";
import { CldImage } from "astro-cloudinary";
---

<section id="welcome-section" class="relative w-full h-[100svh] bg-neon-lime">
    {/* Pinned Background Content */}
    <div
        class="welcome-bg tracking-widest absolute top-0 left-0 w-full h-[100svh] flex flex-col items-center pt-32 bg-neon-lime"
    >
        <h2
            class="text-4xl md:text-6xl lg:text-[8rem] font-black leading-none text-center tracking-tighter"
        >
            #1 MOVIE NETWORK
        </h2>
        <h2
            class="text-3xl md:text-5xl lg:text-[7rem] font-black text-black leading-none text-center tracking-tighter"
        >
            TIKTOK VIETNAM
        </h2>
    </div>

    {/* Sliding Card Layer */}
    <div
        class="welcome-card absolute bottom-0 left-0 w-full h-[100svh] translate-y-full will-change-transform z-10"
    >
        <div
            class="relative w-full h-[100svh] bg-black rounded-t-[3rem] p-8 md:p-16 lg:p-24 landscape:max-h-[100svh] landscape:h-auto flex items-center landscape:items-end landscape:pb-12"
        >
            {/* The Floating Illustration attached to top of card */}
            <div
                class="absolute -top-[55svh] left-1/2 -translate-x-1/2 w-2/3 md:w-1/3 pointer-events-none"
            >
                <!-- Replace this src with your actual illustration asset -->
                <CldImage
                    id="welcome-hero-image"
                    src="tiktok_xcr2fo"
                    alt="Illustration of diverse people sliding"
                    width={800}
                    height={800}
                    crop="fill"
                    class="w-full h-auto object-contain drop-shadow-2xl opacity-0 transition-opacity duration-300 transform-gpu neon-pulse"
                    onload="this.classList.remove('opacity-0')"
                />
            </div>

            {/* Card Content */}
            <div class="w-full md:w-1/2 relative z-10">
                <p
                    class="text-2xl md:text-3xl lg:text-3xl font-medium text-white leading-tight tracking-tight max-w-96 landscape:text-xl"
                >
                    Lêu Hêu nhưng mà <span class="text-neon-lime">chuấtttt</span
                    >
                </p>

                <button
                    class="mt-12 landscape:mt-6 bg-white text-[#2A2A2A] px-8 py-4 landscape:py-2 landscape:px-6 rounded-full font-bold text-lg landscape:text-base flex items-center gap-4 hover:scale-105 transition-transform"
                >
                    Let's goooo
                    <span
                        class="bg-neon-lime w-8 h-8 rounded-full flex items-center justify-center text-white"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2.5"
                            stroke="currentColor"
                            class="w-4 h-4"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
                        </svg>
                    </span>
                </button>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    declare global {
        interface Window {
            initWelcomeAnimation?: () => void;
        }
    }

    window.initWelcomeAnimation = () => {
        gsap.registerPlugin(ScrollTrigger);

        const welcomeSection = document.getElementById("welcome-section");
        const welcomeBg = document.querySelector(".welcome-bg");
        const welcomeCard = document.querySelector(".welcome-card");

        if (!welcomeSection || !welcomeBg || !welcomeCard) return;

        // Create a dedicated timeline for this section
        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: welcomeSection,
                start: "top top",
                end: "+=100%",
                pin: true,
                scrub: 1,
                invalidateOnRefresh: true,
            },
        });

        // 1. Subtle parallax/fade on the background text
        tl.to(
            welcomeBg,
            {
                y: -50,
                opacity: 0.5,
                scale: 0.95,
                ease: "none",
            },
            0,
        );

        // 2. Slide the beige card up from the bottom
        tl.to(
            welcomeCard,
            {
                y: 0,
                ease: "none",
            },
            0,
        );

        // 3. Scale up the illustration as we scroll
        const welcomeHeroImage = document.getElementById("welcome-hero-image");
        if (welcomeHeroImage) {
            tl.fromTo(
                welcomeHeroImage,
                {
                    scale: 0.5,
                    y: 0,
                },
                {
                    scale: 1,
                    y: "150svh",
                    ease: "none",
                },
                0,
            );
        }
    };
</script>

<style>
    .neon-pulse {
        animation: neon-glow 2s ease-in-out infinite alternate;
    }

    @keyframes neon-glow {
        0% {
            filter: drop-shadow(0 0 10px rgba(204, 255, 0, 0.4))
                drop-shadow(0 0 20px rgba(204, 255, 0, 0.2));
        }
        100% {
            filter: drop-shadow(0 0 20px rgba(204, 255, 0, 0.7))
                drop-shadow(0 0 40px rgba(204, 255, 0, 0.5))
                drop-shadow(0 0 60px rgba(204, 255, 0, 0.3));
        }
    }
</style>
