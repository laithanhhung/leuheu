---
import { Heart } from "lucide-astro";
import { getEntry, render } from "astro:content";

const about = await getEntry("sections", "about");
const { data } = about!;
const { Content } = await render(about!);
---

<div
    class="spotlight relative w-full bg-black overflow-hidden selection:bg-neon-lime selection:text-black"
>
    <!-- Seamless Overlay gradient from pure black to hide harsh section cuts -->
    <div class="absolute top-0 left-0 w-full h-[30vh] bg-gradient-to-b from-black via-black/80 to-transparent z-10 pointer-events-none"></div>

    <!-- Atmospheric Cinematic Background (Split from previous stroke-path) -->
    <div class="absolute inset-0 z-0 pointer-events-none">
        <div
            class="absolute top-10 right-[-10%] w-[50vw] h-[50vw] rounded-full bg-neon-lime mix-blend-screen blur-[200px] opacity-[0.05] animate-pulse"
        >
        </div>
        <div
            class="absolute bottom-[-10%] left-[-10%] w-[60vw] h-[60vw] rounded-full bg-blue-900 mix-blend-screen blur-[200px] opacity-10"
        >
        </div>
        <div
            class="absolute inset-0 opacity-[0.03] mix-blend-screen bg-repeat bg-[url('https://grainy-gradients.vercel.app/noise.svg')] pointer-events-none"
        >
        </div>
    </div>

    <!-- Cinematic Split Screen Layout -->
    <section
        class="relative z-10 w-full max-w-screen-2xl mx-auto px-6 md:px-12 lg:px-24 py-32 md:py-48 flex flex-col xl:flex-row gap-16 xl:gap-32"
    >
        <!-- Left: Sticky Massive Title Block -->
        <div class="w-full xl:w-5/12 relative">
            <div class="xl:sticky top-40 flex flex-col">
                <h2
                    class="about-title-reveal text-6xl sm:text-7xl lg:text-8xl 3xl:text-9xl font-black tracking-tighter leading-[0.9] text-white drop-shadow-2xl mb-8 opacity-0 translate-y-12"
                >
                    {data.title}
                    <span
                        class="block text-transparent bg-clip-text bg-gradient-to-r from-neon-lime to-green-500 mt-2 pb-2"
                    >
                        {data.subtitle}
                    </span>
                </h2>

                <div
                    class="about-line-reveal w-1/3 h-1 bg-gradient-to-r from-neon-lime to-transparent rounded-full opacity-0 origin-left mb-12"
                >
                </div>

                <div
                    class="text-gray-400 text-lg sm:text-xl lg:text-2xl leading-relaxed tracking-wide space-y-6 max-w-lg"
                >
                    <p class="about-text-reveal opacity-0 translate-y-8">
                        {data.extraData?.introduction}
                    </p>
                    <p
                        class="about-text-reveal text-gray-500 opacity-0 translate-y-8"
                    >
                        {data.extraData?.introduction2}
                    </p>
                </div>
            </div>
        </div>

        <!-- Right: Vertical Glassmorphism Cards -->
        <div
            class="w-full xl:w-7/12 flex flex-col gap-12 sm:gap-24 pt-12 xl:pt-16 pb-32"
        >
            <!-- Context Box -->
            <div
                class="about-glass-card group relative p-8 sm:p-12 lg:p-16 rounded-[2.5rem] bg-[#0A0A0A]/80 backdrop-blur-3xl border border-white/5 hover:border-neon-lime/30 transition-all duration-700 shadow-2xl hover:shadow-[0_0_80px_rgba(204,255,0,0.05)] overflow-hidden opacity-0 translate-y-24"
            >
                <!-- Inner glow -->
                <div
                    class="absolute -top-32 -right-32 w-64 h-64 bg-neon-lime rounded-full mix-blend-screen blur-[100px] opacity-10 group-hover:opacity-30 transition-all duration-1000"
                >
                </div>
                <div
                    class="absolute -bottom-32 -left-32 w-64 h-64 bg-blue-600 rounded-full mix-blend-screen blur-[100px] opacity-10 group-hover:opacity-20 transition-all duration-1000"
                >
                </div>

                <div class="relative z-10">
                    <div class="flex items-start sm:items-center gap-6 mb-10">
                        <div
                            class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-black/50 border border-white/10 flex items-center justify-center text-neon-lime text-2xl font-black shadow-inner"
                        >
                            #
                        </div>
                        <div>
                            <h3
                                class="text-white text-2xl sm:text-3xl font-bold tracking-tight mb-1"
                            >
                                {data.extraData?.cardTitle}
                            </h3>
                        </div>
                    </div>

                    <div
                        class="bg-black/40 border border-white/5 rounded-2xl p-6 sm:p-8 mb-10 transform -rotate-1 hover:rotate-0 transition-transform duration-500"
                    >
                        <p
                            class="text-gray-300 text-lg sm:text-xl leading-relaxed italic"
                        >
                            "{data.extraData?.cardTagline}"
                        </p>
                    </div>

                    <div
                        class="prose prose-invert prose-lg text-gray-400 mb-12 max-w-none prose-p:leading-relaxed prose-p:text-lg sm:prose-p:text-xl"
                    >
                        <Content />
                    </div>

                    <div
                        class="flex items-center justify-between pt-8 border-t border-white/10 text-gray-500 text-sm tracking-widest uppercase"
                    >
                        <div class="flex items-center gap-3">
                            <Heart class="w-5 h-5 text-neon-lime/60" />
                            <span>{data.extraData?.cardStats}</span>
                        </div>
                        <button
                            class="hover:text-neon-lime transition-colors duration-300"
                            >Chia sẻ</button
                        >
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    function initAboutAnimations() {
        // Sticky Title Reveal
        gsap.to(".about-title-reveal", {
            opacity: 1,
            y: 0,
            duration: 1.2,
            ease: "power4.out",
            scrollTrigger: {
                trigger: ".spotlight",
                start: "top 75%",
            },
        });

        // Glowing Line Reveal
        gsap.to(".about-line-reveal", {
            scaleX: 1,
            opacity: 0.8,
            duration: 1.2,
            delay: 0.4,
            ease: "power3.inOut",
            scrollTrigger: {
                trigger: ".spotlight",
                start: "top 75%",
            },
        });

        // Paragraph Reveals
        gsap.to(".about-text-reveal", {
            opacity: 1,
            y: 0,
            duration: 1,
            stagger: 0.2,
            delay: 0.6,
            ease: "power3.out",
            scrollTrigger: {
                trigger: ".spotlight",
                start: "top 75%",
            },
        });

        // Glassmorphic Card Reveals
        const glassCards = document.querySelectorAll(".about-glass-card");
        glassCards.forEach((card) => {
            gsap.to(card, {
                opacity: 1,
                y: 0,
                duration: 1.5,
                ease: "expo.out",
                scrollTrigger: {
                    trigger: card,
                    start: "top 85%",
                    toggleActions: "play none none reverse",
                },
            });
        });

        // Cinematic slow scroll specifically for this component
        ScrollTrigger.create({
            trigger: ".spotlight",
            start: "top center",
            end: "bottom center",
            onEnter: () => {
                if (window.lenis && window.lenis.options) {
                    window.lenis.options.multiplier = 0.3; // Make it significantly heavier and cinematic
                }
            },
            onLeave: () => {
                if (window.lenis && window.lenis.options) {
                    window.lenis.options.multiplier = 1; // Restore normal speed
                }
            },
            onEnterBack: () => {
                if (window.lenis && window.lenis.options) {
                    window.lenis.options.multiplier = 0.3;
                }
            },
            onLeaveBack: () => {
                if (window.lenis && window.lenis.options) {
                    window.lenis.options.multiplier = 1;
                }
            },
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initAboutAnimations);
    } else {
        initAboutAnimations();
    }
</script>
