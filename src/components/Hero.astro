<section class="hero-section relative w-full h-[100svh] bg-[#050505] text-white flex flex-col justify-center items-center overflow-hidden">
    
    <!-- Atmospheric Ambient Light -->
    <div class="absolute inset-0 z-0 pointer-events-none flex justify-center items-center">
        <div class="hero-ambient-glow absolute w-[60vw] h-[60vw] bg-neon-lime mix-blend-screen rounded-full blur-[150px] opacity-10"></div>
        <div class="absolute inset-0 opacity-[0.03] mix-blend-overlay bg-[url('https://grainy-gradients.vercel.app/noise.svg')]"></div>
    </div>

    <!-- Massive Text Header -->
    <div class="hero-header absolute top-[35%] left-1/2 -translate-x-1/2 -translate-y-1/2 w-full text-center flex flex-col gap-2 md:gap-4 z-10 will-change-transform">
        <h1 class="text-[clamp(4.5rem,14vw,14rem)] font-black leading-none tracking-tighter text-white [text-shadow:0_0_50px_rgba(204,255,0,0.3)] mix-blend-plus-lighter">
            #leuheu
        </h1>
        <p class="text-[clamp(0.6rem,2vw,1.5rem)] font-medium text-gray-400 tracking-[0.4em] sm:tracking-[0.6em] xl:tracking-[0.8em] uppercase">
            ChillChillEntertainment
        </p>
    </div>

    <!-- Animated Falling Icons -->
    <div class="animated-icons fixed bottom-4 md:bottom-8 left-4 right-4 md:left-8 md:right-8 flex items-center gap-4 z-20 will-change-transform">
        <div class="animated-icon flex-1 aspect-square will-change-transform">
            <img src="/icons/icon-1.svg" alt="icon-1" class="w-full h-full object-contain" />
        </div>
        <div class="animated-icon flex-1 aspect-square will-change-transform">
            <img src="/icons/icon-2.svg" alt="icon-2" class="w-full h-full object-contain" />
        </div>
        <div class="animated-icon flex-1 aspect-square will-change-transform">
            <img src="/icons/icon-3.svg" alt="icon-3" class="w-full h-full object-contain" />
        </div>
        <div class="animated-icon flex-1 aspect-square will-change-transform">
            <img src="/icons/icon-4.svg" alt="icon-4" class="w-full h-full object-contain" />
        </div>
        <div class="animated-icon flex-1 aspect-square will-change-transform">
            <img src="/icons/icon-5.svg" alt="icon-5" class="w-full h-full object-contain" />
        </div>
    </div>

    <!-- Sequence Text -->
    <h2 class="animated-text relative max-w-[1200px] text-center text-white text-[clamp(2rem,5vw,4.5rem)] font-black leading-[1.2] z-10 px-4 drop-shadow-[0_0_30px_rgba(255,255,255,0.2)]">
        <div class="placeholder-icon invisible inline-block w-[30px] h-[30px] md:w-[60px] md:h-[60px] align-middle mt-[-4px] md:mt-[-10px] will-change-transform"></div>
        <span class="text-segment opacity-0">Outstanding Accessories</span>
        <div class="placeholder-icon invisible inline-block w-[30px] h-[30px] md:w-[60px] md:h-[60px] align-middle mt-[-4px] md:mt-[-10px] will-change-transform"></div>
        <span class="text-segment opacity-0">Trend of the year</span>
        <div class="placeholder-icon invisible inline-block w-[30px] h-[30px] md:w-[60px] md:h-[60px] align-middle mt-[-4px] md:mt-[-10px] will-change-transform"></div>
        <span class="text-segment opacity-0">Professional Team</span>
        <div class="placeholder-icon invisible inline-block w-[30px] h-[30px] md:w-[60px] md:h-[60px] align-middle mt-[-4px] md:mt-[-10px] will-change-transform"></div>
        <span class="text-segment opacity-0 text-neon-lime drop-shadow-[0_0_20px_rgba(204,255,0,0.4)]">Interval contents</span>
        <div class="placeholder-icon invisible inline-block w-[30px] h-[30px] md:w-[60px] md:h-[60px] align-middle mt-[-4px] md:mt-[-10px] will-change-transform"></div>
        <span class="text-segment opacity-0">Extraordinary Marketing</span>
    </h2>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    declare global {
        interface Window {
            initHeroAnimation?: () => void;
            duplicateIcons?: HTMLElement[] | null;
        }
    }

    window.initHeroAnimation = () => {
        gsap.registerPlugin(ScrollTrigger);

        const heroSection = document.querySelector(".hero-section") as HTMLElement;
        const heroHeader = document.querySelector(".hero-header") as HTMLElement;
        const animatedIcons = document.querySelector(".animated-icons") as HTMLElement;
        const ambientGlow = document.querySelector(".hero-ambient-glow") as HTMLElement;
        const iconElements = document.querySelectorAll<HTMLElement>(".animated-icon");
        const textSegments = document.querySelectorAll<HTMLElement>(".text-segment");
        const placeholders = document.querySelectorAll<HTMLElement>(".placeholder-icon");

        // Shuffle text reveal order
        const textAnimationOrder: { segment: HTMLElement; originalIndex: number }[] = [];
        textSegments.forEach((segment, index) => {
            textAnimationOrder.push({ segment, originalIndex: index });
        });
        for (let i = textAnimationOrder.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [textAnimationOrder[i], textAnimationOrder[j]] = [textAnimationOrder[j], textAnimationOrder[i]];
        }

        const isMobile = window.innerWidth <= 1000;
        const headerIconSize = isMobile ? 30 : 60;
        const currentIconSize = iconElements[0].getBoundingClientRect().width;
        const exactScale = headerIconSize / currentIconSize;

        ScrollTrigger.create({
            trigger: ".hero-section",
            start: "top top",
            end: `+=${window.innerHeight * 8}px`,
            pin: true,
            pinSpacing: true,
            scrub: 1,
            invalidateOnRefresh: true,
            onUpdate: (self) => {
                const progress = self.progress;

                // Always hide text segments unless in phase 4
                textSegments.forEach((seg) => gsap.set(seg, { opacity: 0 }));

                // ─── Phase 1 (0–0.3): Icons float up, header fades ───────────
                if (progress <= 0.3) {
                    const moveProgress = progress / 0.3;
                    const containerMoveY = -window.innerHeight * 0.3 * moveProgress;

                    if (ambientGlow) gsap.set(ambientGlow, { opacity: 0.1, scale: 1 });

                    if (progress <= 0.15) {
                        const hp = progress / 0.15;
                        gsap.set(heroHeader, {
                            transform: `translate(-50%, calc(-50% + ${-50 * hp}px))`,
                            opacity: 1 - hp,
                        });
                    } else {
                        gsap.set(heroHeader, {
                            transform: `translate(-50%, -50%)`,
                            opacity: 0,
                        });
                    }

                    if (window.duplicateIcons) {
                        window.duplicateIcons?.forEach((d) => d.parentNode?.removeChild(d));
                        window.duplicateIcons = null;
                    }

                    gsap.set(animatedIcons, {
                        x: 0,
                        y: containerMoveY,
                        scale: 1,
                        opacity: 1,
                    });

                    iconElements.forEach((icon, index) => {
                        const staggerDelay = index * 0.1;
                        const start = staggerDelay;
                        const end = staggerDelay + 0.5;
                        const ip = gsap.utils.mapRange(start, end, 0, 1, moveProgress);
                        const clamped = Math.max(0, Math.min(1, ip));

                        const startOffSet = -containerMoveY;
                        const individualY = startOffSet * (1 - clamped);
                        gsap.set(icon, {
                            x: 0,
                            y: individualY,
                        });
                    });

                // ─── Phase 2 (0.3–0.6): Scale to center ─────────────────────
                } else if (progress <= 0.6) {
                    const scaleProgress = (progress - 0.3) / 0.3;

                    gsap.set(heroHeader, {
                        transform: `translate(-50%, calc(-50% + -50px))`,
                        opacity: 0,
                    });

                    // Ambient glow gets stronger as icons merge
                    if (ambientGlow) gsap.set(ambientGlow, { opacity: 0.1 + (scaleProgress * 0.1), scale: 1 + scaleProgress });

                    if (window.duplicateIcons) {
                        window.duplicateIcons?.forEach((d) => d.parentNode?.removeChild(d));
                        window.duplicateIcons = null;
                    }

                    const targetCenterY = window.innerHeight / 2;
                    const targetCenterX = window.innerWidth / 2;
                    const containerRect = animatedIcons.getBoundingClientRect();
                    const currentCenterX = containerRect.left + containerRect.width / 2;
                    const currentCenterY = containerRect.top + containerRect.height / 2;
                    const deltaX = (targetCenterX - currentCenterX) * scaleProgress;
                    const deltaY = (targetCenterY - currentCenterY) * scaleProgress;
                    const baseY = -window.innerHeight * 0.3;
                    const currentScale = 1 + (exactScale - 1) * scaleProgress;

                    gsap.set(animatedIcons, {
                        x: deltaX,
                        y: baseY + deltaY,
                        scale: currentScale,
                        opacity: 1,
                    });

                    iconElements.forEach((icon) => gsap.set(icon, { x: 0, y: 0 }));

                // ─── Phase 3 (0.6–0.75): Duplicate icons fly to placeholders ─
                } else if (progress <= 0.75) {
                    const moveProgress = (progress - 0.6) / 0.15;

                    gsap.set(heroHeader, { transform: `translate(-50%, calc(-50% + -50px))`, opacity: 0 });

                    // Maximum glowing atmosphere
                    if (ambientGlow) gsap.set(ambientGlow, { opacity: 0.2 + (moveProgress * 0.1), scale: 2 });

                    const targetCenterX = window.innerWidth / 2;
                    const targetCenterY = window.innerHeight / 2;
                    const containerRect = animatedIcons.getBoundingClientRect();
                    const currentCenterX = containerRect.left + containerRect.width / 2;
                    const currentCenterY = containerRect.top + containerRect.height / 2;
                    const deltaX = (targetCenterX - currentCenterX) * moveProgress;
                    const deltaY = (targetCenterY - currentCenterY) * moveProgress;
                    const baseY = -window.innerHeight * 0.3;

                    gsap.set(animatedIcons, {
                        x: deltaX,
                        y: baseY + deltaY,
                        scale: exactScale,
                        opacity: 0,
                    });
                    iconElements.forEach((icon) => gsap.set(icon, { x: 0, y: 0 }));

                    if (!window.duplicateIcons) {
                        window.duplicateIcons = [];
                        iconElements.forEach((icon) => {
                            const duplicate = icon.cloneNode(true) as HTMLElement;
                            duplicate.className = "duplicate-icon";
                            duplicate.style.position = "absolute";
                            duplicate.style.width = headerIconSize + "px";
                            duplicate.style.height = headerIconSize + "px";
                            duplicate.style.zIndex = "9999";
                            heroSection.appendChild(duplicate);
                            window.duplicateIcons!.push(duplicate);
                        });
                    }

                    window.duplicateIcons?.forEach((dup, i) => {
                        if (i >= placeholders.length) return;
                        const iconRect = iconElements[i].getBoundingClientRect();
                        const startViewportX = iconRect.left + iconRect.width / 2;
                        const startViewportY = iconRect.top + iconRect.height / 2;
                        const targetRect = placeholders[i].getBoundingClientRect();
                        const targetViewportX = targetRect.left + targetRect.width / 2;
                        const targetViewportY = targetRect.top + targetRect.height / 2;
                        const moveX = targetViewportX - startViewportX;
                        const moveY = targetViewportY - startViewportY;

                        let currentX = 0, currentY = 0;
                        if (moveProgress <= 0.5) {
                            currentY = moveY * (moveProgress / 0.5);
                        } else {
                            currentX = moveX * ((moveProgress - 0.5) / 0.5);
                            currentY = moveY;
                        }

                        dup.style.left = `${startViewportX + currentX - headerIconSize / 2}px`;
                        dup.style.top = `${startViewportY + currentY - headerIconSize / 2}px`;
                        dup.style.opacity = "1";
                        dup.style.display = "flex";
                    });

                // ─── Phase 4 (0.75–1.0): Text segments reveal ───────────────
                } else {
                    gsap.set(heroHeader, { transform: `translate(-50%, calc(-50% + -100px))`, opacity: 0 });
                    
                    if (ambientGlow) gsap.set(ambientGlow, { opacity: 0.3, scale: 2 });
                    gsap.set(animatedIcons, { opacity: 0 });

                    window.duplicateIcons?.forEach((dup, i) => {
                        if (i >= placeholders.length) return;
                        const targetRect = placeholders[i].getBoundingClientRect();
                        const tx = targetRect.left + targetRect.width / 2;
                        const ty = targetRect.top + targetRect.height / 2;
                        dup.style.left = `${tx - headerIconSize / 2}px`;
                        dup.style.top = `${ty - headerIconSize / 2}px`;
                        dup.style.opacity = "1";
                        dup.style.display = "flex";
                    });

                    textAnimationOrder.forEach((item, index) => {
                        const segStart = 0.75 + index * 0.03;
                        const segEnd = segStart + 0.015;
                        const segProgress = Math.max(
                            0,
                            Math.min(1, gsap.utils.mapRange(segStart, segEnd, 0, 1, progress))
                        );
                        gsap.set(item.segment, { opacity: segProgress });
                    });
                }
            },
        });
    };
</script>
