---
import { getCollection } from "astro:content";
import CampaignCard from "./CampaignCard.astro";
import SignificantCampaign from "./SignificantCampaign.astro";

const campaigns = await getCollection("campaigns");
const sortedCampaigns = campaigns.sort(
    (a, b) => (a.data.order || 0) - (b.data.order || 0),
);
---

<section class="campaign-section relative w-full">
    {/* Campaign Cards Loop */}
    <div class="campaigns-container w-full bg-[#0a0a0a]">
        <div
            class="campaign-container w-full h-auto min-h-[105svh] md:min-h-[120svh] relative"
        >
            <SignificantCampaign className="campaign-card" />
        </div>

        {
            sortedCampaigns.map((campaign, index) => (
                <div class="campaign-container w-full h-auto min-h-[0] xs:h-[100svh] xs:min-h-[100svh] relative mb-[8%] xs:mb-0">
                    <CampaignCard
                        className="campaign-card overflow-hidden relative w-full h-full transform origin-bottom-left will-change-transform rotate-[30deg]"
                        campaign={campaign.data}
                    />
                </div>
            ))
        }
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    declare global {
        interface Window {
            initCampaignAnimation?: () => void;
        }
    }

    window.initCampaignAnimation = () => {
        const campaignContainers = document.querySelectorAll(
            ".campaign-container",
        );

        campaignContainers.forEach((container, index) => {
            const card = container.querySelector(".campaign-card") as HTMLElement | null;
            if (!card) return;

            const isFirst = index === 0;
            const track = container.querySelector(".horizontal-gallery-track") as HTMLElement | null;
            const wrapper = track?.parentElement;

            // Compute Horizontal Offset
            const computeMaxSlide = () => (track && wrapper) ? Math.max(0, track.scrollWidth - wrapper.offsetWidth + 64) : 0;
            const horizontalDuration = computeMaxSlide() * 1.5; // Scale for scroll feel
            const pinDuration = horizontalDuration + window.innerHeight; // How long it stays pinned

            // 1. Entrance rotation (Skip for SignificantCampaign)
            if (!isFirst) {
                gsap.to(card, {
                    rotate: 0,
                    ease: "none",
                    scrollTrigger: {
                        trigger: container,
                        start: "top bottom",
                        end: "top 20%",
                        scrub: true,
                        invalidateOnRefresh: true,
                    },
                });
            }

            // 2. The "Vuốt Vuốt" Stacking (Stays anchored at bottom while next card covers it)
            // We use pinSpacing: false to allow stacking.
            // But we add manual margin-bottom to the container to PUSH the next card
            // for the duration of the horizontal scroll.
            if (!isFirst && horizontalDuration > 0) {
                (container as HTMLElement).style.marginBottom = `${horizontalDuration}px`;
            }

            const pinTl = gsap.timeline({
                scrollTrigger: {
                    trigger: container,
                    start: "bottom bottom",
                    // For Card 0, pin for 100vh so Card 1 can cover it.
                    // For others, pin for horizontal scrub + 100vh for next card to cover.
                    end: () => `+=${isFirst ? window.innerHeight : pinDuration}`,
                    pin: true,
                    pinSpacing: false,
                    scrub: true,
                    invalidateOnRefresh: true,
                }
            });

            // If there's a gallery (and not first card), scrub it during the first part of the pin
            if (!isFirst && track && horizontalDuration > 0) {
                pinTl.to(track, {
                    x: () => -computeMaxSlide(),
                    ease: "none",
                    duration: horizontalDuration / pinDuration
                });
                // After scrub, the Timeline continues (waiting) for window.innerHeight 
                // while the next card covers us.
                pinTl.to({}, { duration: window.innerHeight / pinDuration });
            }
        });

        // Set higher z-index for later cards to ensure they cover previous ones
        campaignContainers.forEach((c, i) => {
            (c as HTMLElement).style.zIndex = (i + 1).toString();
        });

        // Refresh triggers after adding margins and z-index
        ScrollTrigger.refresh();
    };
</script>

<style>
    @media (max-width: 1000px) {
        .campaigns-container {
            width: 100%;
        }

        .campaign-container {
            width: 100%;
        }
    }
</style>
