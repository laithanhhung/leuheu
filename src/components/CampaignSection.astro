---
import { getCollection } from "astro:content";
import CampaignCard from "./CampaignCard.astro";
import SignificantCampaign from "./SignificantCampaign.astro";

const campaigns = await getCollection("campaigns");
const sortedCampaigns = campaigns.sort(
    (a, b) => (a.data.order || 0) - (b.data.order || 0),
);
---

<section class="relative w-full">
    {/* Campaign Cards Loop */}
    <div class="campaigns-container w-full bg-[#0a0a0a]">
        <div
            class="campaign-container w-full h-auto min-h-[120svh] relative"
        >
            <SignificantCampaign className="campaign-card" />
        </div>

        {
            sortedCampaigns.map((campaign, index) => (
                <div 
                    class="campaign-container w-full h-[auto] min-h-[0] xs:h-[100svh] xs:min-h-[100svh] relative mb-16 xs:mb-0"
                >
                    <CampaignCard
                        className="campaign-card overflow-hidden relative w-full h-full transform origin-bottom-left will-change-transform rotate-[30deg]"
                        campaign={campaign.data}
                    />
                </div>
            ))
        }
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    declare global {
        interface Window {
            initCampaignAnimation?: () => void;
        }
    }

    window.initCampaignAnimation = () => {
        const campaignContainers = document.querySelectorAll(
            ".campaign-container",
        );

        campaignContainers.forEach((container, index) => {
            const card = container.querySelector(".campaign-card");
            if (!card) return;

            // Slide and rotate entrance - SKIP for SignificantCampaign (index 0)
            if (index > 0) {
                gsap.to(card, {
                    rotate: 0,
                    ease: "none",
                    scrollTrigger: {
                        trigger: container,
                        start: "top bottom",
                        end: "top 0%",
                        scrub: true,
                        invalidateOnRefresh: true,
                    },
                });
            }

            const track = container.querySelector(".horizontal-gallery-track");
            let scrollDistance = window.innerHeight; // Default 100vh pin
            let maxSlide = 0;
            
            if (track && track.parentElement) {
                // Determine how far the track needs to slide to reveal all images
                // Uses wrapperWidth to mathematically perfectly compute the horizontal overflow amount
                const wrapperWidth = track.parentElement.offsetWidth;
                maxSlide = track.scrollWidth - wrapperWidth + 40; 
                if (maxSlide > 0) {
                    scrollDistance = Math.max(window.innerHeight, maxSlide);
                }
            }

            // Create a single unified timeline to prevent GSAP pin-spacer desync on reverse scroll
            const isLast = index === campaignContainers.length - 1;
            const isFirst = index === 0;
            
            // CHỈ PIN NẾU KHÔNG PHẢI LÀ TẤM ĐẦU TIÊN (SignificantCampaign)
            if (!isFirst && (!isLast || (track && maxSlide > 0))) {
                const pinTl = gsap.timeline({
                    scrollTrigger: {
                        trigger: container,
                        start: "top top", // Pin immediately upon reaching top
                        end: () => `+=${scrollDistance}`,
                        pin: true,
                        pinSpacing: true, 
                        scrub: true,
                        invalidateOnRefresh: true,
                    }
                });

                if (track && maxSlide > 0) {
                    pinTl.to(track, {
                        x: -maxSlide,
                        ease: "none",
                    });
                } else {
                    // Empty tween so the pin holds time correctly even if no gallery
                    pinTl.to(container, { x: 0, duration: 1 });
                }
            }
        });
    };
</script>
