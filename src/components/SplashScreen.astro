<!-- Loader: 10-bar overlay + counter + leuheu letter reveal -->
<div id="lh-splash">
    <!-- Counter -->
    <div id="lh-counter">0</div>

    <!-- Bar overlay -->
    <div id="lh-overlay">
        <div class="lh-bar"></div>
        <div class="lh-bar"></div>
        <div class="lh-bar"></div>
        <div class="lh-bar"></div>
        <div class="lh-bar"></div>
        <div class="lh-bar"></div>
        <div class="lh-bar"></div>
        <div class="lh-bar"></div>
        <div class="lh-bar"></div>
        <div class="lh-bar"></div>
    </div>

    <!-- Brand letters -->
    <div id="lh-header">
        <div class="lh-letter">l</div>
        <div class="lh-letter">e</div>
        <div class="lh-letter">u</div>
        <div class="lh-letter">h</div>
        <div class="lh-letter">e</div>
        <div class="lh-letter">u</div>
    </div>
</div>

<style is:global>
    #lh-splash {
        position: fixed;
        inset: 0;
        z-index: 9999;
        overflow: hidden;
        background: #000;
        pointer-events: none;
    }

    #lh-counter {
        position: fixed;
        bottom: 0;
        right: 0;
        z-index: 10001;
        color: #000000;
        font-size: clamp(8rem, 20vw, 22rem);
        font-weight: 900;
        line-height: 1;
        padding: 0.1em 0.25em;
        font-family: sans-serif;
    }

    #lh-overlay {
        position: fixed;
        inset: 0;
        z-index: 10000;
        display: flex;
    }

    .lh-bar {
        width: 10vw;
        height: 105svh;
        background-color: #c7f900;
    }

    #lh-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 10002;
        display: flex;
        justify-content: space-between;
        padding: 0.15em 0.3em;
        overflow: hidden;
    }

    .lh-letter {
        font-size: clamp(4rem, 22vw, 28rem);
        font-weight: 900;
        color: #141414;
        line-height: 1;
        font-family: sans-serif;
        transform: translateY(110%);
    }
</style>

<script>
    import { gsap } from "gsap";

    // Counter
    const counterEl = document.getElementById("lh-counter")!;
    let count = 0;
    function tick() {
        if (count >= 100) return;
        count = Math.min(100, count + Math.floor(Math.random() * 10) + 1);
        counterEl.textContent = String(count);
        setTimeout(tick, Math.floor(Math.random() * 180) + 40);
    }
    tick();

    // Bars collapse → letters slide up → remove splash
    gsap.to("#lh-counter", {
        delay: 3.5,
        duration: 0.25,
        opacity: 0,
    });

    gsap.to(".lh-bar", {
        delay: 3.5,
        duration: 1.5,
        height: 0,
        stagger: { amount: 0.5 },
        ease: "power4.inOut",
    });

    gsap.to(".lh-letter", {
        delay: 4,
        duration: 1.5,
        y: 0,
        stagger: { amount: 0.5 },
        ease: "power4.inOut",
    });

    // After letters have risen, slide the whole splash up and remove
    gsap.to("#lh-splash", {
        delay: 5.8,
        duration: 1,
        y: "-100%",
        ease: "power4.inOut",
        onComplete: () => {
            document.getElementById("lh-splash")?.remove();
        },
    });
</script>
