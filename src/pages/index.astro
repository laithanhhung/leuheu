---
import { getCollection } from "astro:content";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import About from "../components/About.astro";
import Stats from "../components/Stats.astro";
import Services from "../components/Services.astro";
import CampaignCard from "../components/CampaignCard.astro";
import Partners from "../components/Partners.astro";
import Footer from "../components/Footer.astro";
import SplashScreen from "../components/SplashScreen.astro";

const campaigns = await getCollection("campaigns");
const sortedCampaigns = campaigns.sort(
    (a, b) => (a.data.order || 0) - (b.data.order || 0),
);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Leu Heu</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800;900&display=swap"
            rel="stylesheet"
        />
        <style is:global>
            body {
                background-color: #000000;
            }
            .hide-scrollbar::-webkit-scrollbar {
                display: none;
            }
            .hide-scrollbar {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }
            /* Ensure selection color matches original design */
            ::selection {
                background-color: #ccff00;
                color: #000000;
            }
        </style>
    </head>
    <body class="font-sans overflow-x-hidden">
        {/* Splash Screen */}
        <SplashScreen />
        <div class="relative h-full overflow-hidden">
            <Hero />

            <div class="text-neon-lime">
                <Marquee
                    text="ChiuChiuEntertainment #leuheu "
                    className="bg-black text-neon-lime"
                />
            </div>
            <div class="spotlight relative h-full w-full overflow-hidden">
                <!-- Welcome -->

                <!-- About -->
                <About />
                <!-- Stats -->
                <Stats />
                <!-- Services -->
                <Services />
                <!-- Background SVG -->
                <div
                    class="absolute xl:top-[25svh] xl:left-[50svw] -translate-x-1/2 w-[90%] h-full -z-10 pointer-events-none"
                >
                    <svg
                        width="1323"
                        height="4944"
                        viewBox="0 0 1323 4944"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            id="stroke-path"
                            d="M340.381 185.004C7.19728 466.504 247.065 870.504 707.881 1182.5C1168.7 1494.5 1159.2 1969.5 943.197 2305.5C727.197 2641.5 293.197 2493 293.197 2185C293.197 1877 637.698 1784.5 844.698 1975.5C1051.7 2166.5 1367.26 2509 770.698 3221C174.138 3933 46.1976 4712.5 1137.7 4759"
                            stroke="#CCFF00"
                            stroke-width="370"
                            stroke-linecap="round"></path>
                    </svg>
                </div>
            </div>
            <!-- Campaigns -->
            <section class="relative w-full">
                {/* Campaign Cards Loop */}
                <div class="campaigns-container w-full">
                    <div
                        class="campaign-container w-full h-[auto] min-h-[0] xs:h-[100vh] xs:min-h-[100vh] relative mb-16 xs:mb-0"
                    >
                        <div
                            class="campaign-card relative w-full h-full flex items-center bg-neon-lime origin-bottom-left"
                        >
                            <div
                                class="max-w-4xl 3xl:max-w-7xl mx-auto bg-white rounded-[1.5rem] xs:rounded-[2rem] p-6 xs:p-8 md:p-12 flex flex-col md:flex-row items-center gap-8 xs:gap-12 mb-16 xs:mb-20"
                            >
                                <div
                                    class="flex-1 w-full text-center md:text-left"
                                >
                                    <h2
                                        class="text-3xl xs:text-4xl md:text-6xl 3xl:text-7xl font-black text-black uppercase leading-none"
                                    >
                                        Significant <br />
                                        <span
                                            class="text-transparent bg-clip-text bg-gradient-to-r from-black to-gray-600"
                                            >Campaigns</span
                                        >
                                    </h2>
                                    <p
                                        class="mt-4 text-gray-600 font-medium text-sm xs:text-base 3xl:text-xl"
                                    >
                                        #leuheu with partners
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    {
                        sortedCampaigns.map((campaign, index) => (
                            <div class="campaign-container w-full h-[auto] min-h-[0] xs:h-[100vh] xs:min-h-[100vh] relative mb-16 xs:mb-0 ">
                                <CampaignCard
                                    className="campaign-card relative w-full h-full transform origin-bottom-left will-change-transform rotate-[30deg]"
                                    campaign={campaign.data}
                                />
                            </div>
                        ))
                    }
                </div>
            </section>

            <Partners />
            <Footer />
        </div>

        <script>
            import { gsap } from "gsap";
            import { ScrollTrigger } from "gsap/ScrollTrigger";
            // import { SplitText } from "gsap/SplitText";
            import Lenis from "lenis";

            // Register plugins
            gsap.registerPlugin(ScrollTrigger);
            // If you have SplitText (Club GSAP), uncomment the import above and register it here:
            // gsap.registerPlugin(SplitText);

            // Initialize Lenis once
            const lenis = new Lenis();

            // Sincronize Lenis with ScrollTrigger
            lenis.on("scroll", ScrollTrigger.update);

            // Add Lenis's requestAnimationFrame (raf) method to GSAP's ticker
            gsap.ticker.add((time) => {
                lenis.raf(time * 1000);
            });

            // Disable lag smoothing in GSAP to prevent jumps
            gsap.ticker.lagSmoothing(0);

            // Main Animation Logic
            function initAnimations() {
                // SVG Path Animation
                const path = document.getElementById(
                    "stroke-path",
                ) as SVGPathElement | null;
                if (path) {
                    const length = path.getTotalLength();
                    // Set up the starting positions
                    path.style.strokeDasharray = length + " " + length;
                    path.style.strokeDashoffset = String(length);

                    // Trigger the animation on scrub
                    gsap.to(path, {
                        strokeDashoffset: 0,
                        ease: "none",
                        scrollTrigger: {
                            trigger: ".spotlight",
                            start: "top top",
                            end: "bottom bottom",
                            scrub: true,
                        },
                    });
                }

                // Campaign Cards Animation
                const campaignContainers = document.querySelectorAll(
                    ".campaign-container",
                );

                campaignContainers.forEach((container, index) => {
                    const card = container.querySelector(".campaign-card");
                    if (!card) return;

                    gsap.to(card, {
                        rotate: 0,
                        ease: "none",
                        scrollTrigger: {
                            trigger: container,
                            start: "top bottom",
                            end: "top 20%",
                            scrub: true,
                        },
                    });

                    if (index !== campaignContainers.length - 1) {
                        ScrollTrigger.create({
                            trigger: container,
                            start: "bottom bottom",
                            end: "bottom top",
                            pin: true,
                            pinSpacing: false,
                        });
                    }
                });
            }

            // Execute logic when ready
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", initAnimations);
            } else {
                initAnimations();
            }
        </script>
    </body>
</html>
