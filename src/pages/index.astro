---
import { getCollection } from "astro:content";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import Welcome from "../components/Welcome.astro";
import About from "../components/About.astro";
import Stats from "../components/Stats.astro";
import Services from "../components/Services.astro";
import WaveDivider from "../components/WaveDivider.astro";
import CampaignSection from "../components/CampaignSection.astro";
import Partners from "../components/Partners.astro";
import Footer from "../components/Footer.astro";
import SplashScreen from "../components/SplashScreen.astro";
import TikTokAward from "../components/TikTokAward.astro";
import LandscapePrompt from "../components/LandscapePrompt.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Leu Heu</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800;900&display=swap"
            rel="stylesheet"
        />
        <style is:global>
            body {
                background-color: #000000;
            }
            .hide-scrollbar::-webkit-scrollbar {
                display: none;
            }
            .hide-scrollbar {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }
            /* Ensure selection color matches original design */
            ::selection {
                background-color: #c7f900;
                color: #000000;
            }
        </style>
    </head>
    <body class="font-sans overflow-x-hidden">
        {/* Splash Screen */}
        <SplashScreen />
        
        {/* Landscape Prompt for mobile portrait mode */}
        <LandscapePrompt />

        <div class="relative h-full overflow-hidden">
            <Hero />

            <div class="text-neon-lime">
                <Marquee
                    text="ChiuChiuEntertainment #leuheu "
                    className="bg-black text-neon-lime"
                />
            </div>
            <!-- Welcome -->
            <Welcome />
            <!-- About -->
            <About />
            <!-- Background SVG -->
            <WaveDivider />
            <!-- Stats -->
            <Stats />
            <!-- Services -->
            <Services />
            <!-- Campaigns -->
            <CampaignSection />
            <!-- Tiktok Award -->
            <TikTokAward />

            <Partners />
            <Footer />
        </div>

        <script>
            import { gsap } from "gsap";
            import { ScrollTrigger } from "gsap/ScrollTrigger";
            // import { SplitText } from "gsap/SplitText";
            import Lenis from "lenis";

            // Register plugins
            gsap.registerPlugin(ScrollTrigger);
            // If you have SplitText (Club GSAP), uncomment the import above and register it here:
            // gsap.registerPlugin(SplitText);

            // Extend window correctly for the global TS declaration
            declare global {
                interface Window {
                    initHeroAnimation?: () => void;
                    initWelcomeAnimation?: () => void;
                    initStatsAnimation?: () => void;
                    initServicesAnimation?: () => void;
                    initTikTokAwardAnimation?: () => void;
                    initCampaignAnimation?: () => void;
                    initSpotlightAnimation?: () => void;
                    duplicateIcons?: HTMLElement[] | null;
                    lenis?: any;
                }
            }

            // Initialize Lenis once for standard unified scrolling
            const lenis = new Lenis({
                lerp: 0.1,  // Standard smooth interpolation
                wheelMultiplier: 1, // Normal scrolling distance
                smoothWheel: true,
            });

            window.lenis = lenis;

            // Synchronize Lenis with ScrollTrigger
            lenis.on("scroll", ScrollTrigger.update);

            // Add Lenis's requestAnimationFrame (raf) method to GSAP's ticker
            gsap.ticker.add((time) => {
                lenis.raf(time * 1000);
            });

            // Disable lag smoothing in GSAP to prevent jumps
            gsap.ticker.lagSmoothing(0);

            // Main Animation Logic
            function initAnimations() {
                // Call the Hero animation first (first visible section)
                if (typeof window.initHeroAnimation === "function") {
                    window.initHeroAnimation();
                }

                // Call the Welcome animation (right after Hero)
                if (typeof window.initWelcomeAnimation === "function") {
                    window.initWelcomeAnimation();
                }

                // Call the globally exposed Spotlight animation script
                if (typeof window.initSpotlightAnimation === "function") {
                    window.initSpotlightAnimation();
                }

                // Call the globally exposed Stats animation script now that GSAP/Lenis is ready
                if (typeof window.initStatsAnimation === "function") {
                    window.initStatsAnimation();
                }

                // Call the globally exposed Services animation script
                if (typeof window.initServicesAnimation === "function") {
                    window.initServicesAnimation();
                }

                // Call the globally exposed Campaign animation script
                if (typeof window.initCampaignAnimation === "function") {
                    window.initCampaignAnimation();
                }

                // Call the TikTok Award animation script
                if (typeof window.initTikTokAwardAnimation === "function") {
                    window.initTikTokAwardAnimation();
                }

                // Single refresh after ALL triggers are registered
                ScrollTrigger.refresh();
            }

            // Execute logic when ready
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", initAnimations);
            } else {
                initAnimations();
            }
        </script>
    </body>
</html>
