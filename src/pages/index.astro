                    <circle cx="288" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="352" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="416" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="480" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="544" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="608" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="672" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="736" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="800" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="864" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="928" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="992" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="1056" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="1120" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="1184" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="1248" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="1312" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="1376" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="1440" cy="32" r="32" fill="#C7F900"></circle>
                    <rect y="32" width="1537" height="32" fill="#C7F900"></rect>
                    <circle cx="1504" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="32" cy="32" r="32" fill="#C7F900"></circle>
                </svg>
                <!-- Layer 2 (Middle) -->
                <svg
                    class="w-[150vw] md:w-[120vw] flex-shrink-0 h-auto opacity-60 translate-x-[1vw] -mt-[4vw] md:-mt-[3vw] drop-shadow-lg"
