                    <circle cx="864" cy="32" r="32" fill="#B0DB00"></circle>
                    <circle cx="928" cy="32" r="32" fill="#B0DB00"></circle>
                    <circle cx="992" cy="32" r="32" fill="#B0DB00"></circle>
                    <circle cx="1056" cy="32" r="32" fill="#B0DB00"></circle>
                    <circle cx="1120" cy="32" r="32" fill="#B0DB00"></circle>
                    <circle cx="1184" cy="32" r="32" fill="#B0DB00"></circle>
                    <circle cx="1248" cy="32" r="32" fill="#B0DB00"></circle>
                    <circle cx="1312" cy="32" r="32" fill="#B0DB00"></circle>
                    <circle cx="1376" cy="32" r="32" fill="#B0DB00"></circle>
                    <circle cx="1440" cy="32" r="32" fill="#B0DB00"></circle>
                    <rect y="32" width="1537" height="32" fill="#B0DB00"></rect>
                    <circle cx="1504" cy="32" r="32" fill="#B0DB00"></circle>
                    <circle cx="32" cy="32" r="32" fill="#B0DB00"></circle>
                </svg>
                <!-- Layer 4 (Transition) -->
                <svg
                    class="w-[150vw] md:w-[120vw] flex-shrink-0 h-auto opacity-100 translate-x-[1vw] -mt-[4vw] md:-mt-[3vw] drop-shadow-2xl z-20"
                    viewBox="0 0 1537 64"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <circle cx="96" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="160" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="224" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="288" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="352" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="416" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="480" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="544" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="608" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="672" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="736" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="800" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="864" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="928" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="992" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="1056" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="1120" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="1184" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="1248" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="1312" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="1376" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="1440" cy="32" r="32" fill="#C7F900"></circle>
                    <rect y="32" width="1537" height="32" fill="#C7F900"></rect>
                    <circle cx="1504" cy="32" r="32" fill="#C7F900"></circle>
                    <circle cx="32" cy="32" r="32" fill="#C7F900"></circle>
                </svg>
                <!-- Filler for fractional pixel gaps -->
                <div class="w-[150vw] h-4 bg-[#C7F900] -mt-1 relative z-20">
                </div>
            </section>
            <!-- Campaigns -->
            <CampaignSection />
            <!-- Tiktok Award -->
            <TikTokAward />

            <Partners />
            <Footer />
        </div>

        <script>
            import { gsap } from "gsap";
            import { ScrollTrigger } from "gsap/ScrollTrigger";
            // import { SplitText } from "gsap/SplitText";
            import Lenis from "lenis";

            // Register plugins
            gsap.registerPlugin(ScrollTrigger);
            // If you have SplitText (Club GSAP), uncomment the import above and register it here:
            // gsap.registerPlugin(SplitText);

            // Extend window correctly for the global TS declaration
            declare global {
                interface Window {
                    initStatsAnimation?: () => void;
                    initTikTokAwardAnimation?: () => void;
                    initCampaignAnimation?: () => void;
                    initSpotlightAnimation?: () => void;
                }
            }

            // Initialize Lenis once
            const lenis = new Lenis({
                lerp: 0.05, // Lower value for smoother scrolling (default is 0.1)
                wheelMultiplier: 0.4, // Slows down wheel scroll step
                smoothWheel: true,
            });

            // Sincronize Lenis with ScrollTrigger
            lenis.on("scroll", ScrollTrigger.update);

            // Add Lenis's requestAnimationFrame (raf) method to GSAP's ticker
            gsap.ticker.add((time) => {
                lenis.raf(time * 1000);
            });

            // Disable lag smoothing in GSAP to prevent jumps
            gsap.ticker.lagSmoothing(0);

            // Main Animation Logic
            function initAnimations() {
                // Call the globally exposed Spotlight animation script
                if (typeof window.initSpotlightAnimation === "function") {
                    window.initSpotlightAnimation();
                }

                // Call the globally exposed Stats animation script now that GSAP/Lenis is ready
                if (typeof window.initStatsAnimation === "function") {
                    window.initStatsAnimation();
                }

                // Call the TikTok Award animation script
                if (typeof window.initTikTokAwardAnimation === "function") {
                    window.initTikTokAwardAnimation();
                }

                // Call the globally exposed Campaign animation script
                if (typeof window.initCampaignAnimation === "function") {
                    window.initCampaignAnimation();
                }
            }

            // Execute logic when ready
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", initAnimations);
            } else {
                initAnimations();
            }
        </script>
    </body>
</html>
