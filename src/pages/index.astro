---
import { getCollection } from "astro:content";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import Welcome from "../components/Welcome.astro";
import About from "../components/About.astro";
import Stats from "../components/Stats.astro";
import Services from "../components/Services.astro";
import CampaignCard from "../components/CampaignCard.astro";
import Partners from "../components/Partners.astro";
import Footer from "../components/Footer.astro";
import SplashScreen from "../components/SplashScreen.astro";

const campaigns = await getCollection("campaigns");
const sortedCampaigns = campaigns.sort(
    (a, b) => (a.data.order || 0) - (b.data.order || 0),
);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Leu Heu</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800;900&display=swap"
            rel="stylesheet"
        />
        <style is:global>
            body {
                background-color: #000000;
            }
            .hide-scrollbar::-webkit-scrollbar {
                display: none;
            }
            .hide-scrollbar {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }
            /* Ensure selection color matches original design */
            ::selection {
                background-color: #ccff00;
                color: #000000;
            }
        </style>
    </head>
    <body class="font-sans overflow-x-hidden">
        {/* Splash Screen */}
        <SplashScreen />
        <div class="relative h-full overflow-hidden">
            <Hero />

            <div class="text-neon-lime">
                <Marquee
                    text="ChiuChiuEntertainment #leuheu "
                    className="bg-black text-neon-lime"
                />
            </div>
            <!-- Welcome -->
            <Welcome />
            <div class="spotlight relative h-full w-full">
                <!-- section empty -->
                <section class="h-[100vh] w-full"></section>
                <!-- About -->
                <About />
                <!-- Stats -->
                <Stats />
                <!-- Services -->
                <Services />
                <!-- Background SVG -->
                <div
                    class="absolute top-[50svh] xs:left-[25svw] sm:left-[25svw] md:left-[25svw] lg:left-[25svw] xl:top-[5svh] xl:left-[45svw] -translate-x-1/2 w-[90%] h-full -z-10 pointer-events-none"
                >
                    <svg
                        width="1328"
                        height="5382"
                        viewBox="0 0 1328 5382"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            id="stroke-path"
                            d="M722.619 185.029C1504.62 649.529 1029.51 1241.03 614.82 1620.39C200.135 1999.75 91.8898 2487.02 379.504 2743.27C667.119 2999.53 1029.51 2930.76 1029.51 2622.79C1029.51 2314.82 685.005 2222.33 478.004 2413.31C271.004 2604.29 -44.5562 2946.75 552.004 3658.68C1148.57 4370.61 1276.51 5150.03 185.003 5196.53"
                            stroke="#CCFF00"
                            class="[stroke-width:100px] xs:[stroke-width:100px] sm:[stroke-width:150px] md:[stroke-width:200px] lg:[stroke-width:250px] xl:[stroke-width:350px]"
                            stroke-width="370"
                            stroke-linecap="round"></path>
                    </svg>
                </div>
            </div>
            <!-- Tiktok Award: build later -->
            <!-- Campaigns -->
            <section class="relative w-full">
                {/* Campaign Cards Loop */}
                <div class="campaigns-container w-full">
                    <div
                        class="campaign-container w-full h-[auto] min-h-[0] xs:h-[100vh] xs:min-h-[100vh] relative mb-16 xs:mb-0"
                    >
                        <div
                            class="campaign-card relative w-full h-full flex items-center bg-neon-lime origin-bottom-left"
                        >
                            <div
                                class="max-w-4xl 3xl:max-w-7xl mx-auto bg-white rounded-[1.5rem] xs:rounded-[2rem] p-6 xs:p-8 md:p-12 flex flex-col md:flex-row items-center gap-8 xs:gap-12 mb-16 xs:mb-20"
                            >
                                <div
                                    class="flex-1 w-full text-center md:text-left"
                                >
                                    <h2
                                        class="text-3xl xs:text-4xl md:text-6xl 3xl:text-7xl font-black text-black uppercase leading-none"
                                    >
                                        Significant <br />
                                        <span
                                            class="text-transparent bg-clip-text bg-gradient-to-r from-black to-gray-600"
                                            >Campaigns</span
                                        >
                                    </h2>
                                    <p
                                        class="mt-4 text-gray-600 font-medium text-sm xs:text-base 3xl:text-xl"
                                    >
                                        #leuheu with partners
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    {
                        sortedCampaigns.map((campaign, index) => (
                            <div class="campaign-container w-full h-[auto] min-h-[0] xs:h-[100vh] xs:min-h-[100vh] relative mb-16 xs:mb-0 ">
                                <CampaignCard
                                    className="campaign-card relative w-full h-full transform origin-bottom-left will-change-transform rotate-[30deg]"
                                    campaign={campaign.data}
                                />
                            </div>
                        ))
                    }
                </div>
            </section>

            <Partners />
            <Footer />
        </div>

        <script>
            import { gsap } from "gsap";
            import { ScrollTrigger } from "gsap/ScrollTrigger";
            // import { SplitText } from "gsap/SplitText";
            import Lenis from "lenis";

            // Register plugins
            gsap.registerPlugin(ScrollTrigger);
            // If you have SplitText (Club GSAP), uncomment the import above and register it here:
            // gsap.registerPlugin(SplitText);

            // Initialize Lenis once
            const lenis = new Lenis({
                lerp: 0.05, // Lower value for smoother scrolling (default is 0.1)
                wheelMultiplier: 0.4, // Slows down wheel scroll step
                smoothWheel: true,
            });

            // Sincronize Lenis with ScrollTrigger
            lenis.on("scroll", ScrollTrigger.update);

            // Add Lenis's requestAnimationFrame (raf) method to GSAP's ticker
            gsap.ticker.add((time) => {
                lenis.raf(time * 1000);
            });

            // Disable lag smoothing in GSAP to prevent jumps
            gsap.ticker.lagSmoothing(0);

            // Main Animation Logic
            function initAnimations() {
                // SVG Path Animation
                const path = document.getElementById(
                    "stroke-path",
                ) as SVGPathElement | null;
                if (path) {
                    const length = path.getTotalLength();
                    // Set up the starting positions
                    path.style.strokeDasharray = length + " " + length;
                    path.style.strokeDashoffset = String(length);

                    // Trigger the animation on scrub
                    gsap.to(path, {
                        strokeDashoffset: 0,
                        ease: "none",
                        scrollTrigger: {
                            trigger: ".spotlight",
                            start: "top top",
                            end: () => {
                                const spotlight = document.querySelector(
                                    ".spotlight",
                                ) as HTMLElement | null;
                                const campaign = document.querySelector(
                                    ".campaigns-container",
                                ) as HTMLElement | null;
                                if (spotlight && campaign) {
                                    // Calculate precise pixel distance from start of spotlight to campaign container
                                    const distance =
                                        campaign.getBoundingClientRect().top -
                                        spotlight.getBoundingClientRect().top;
                                    return `+=${distance}`;
                                }
                                return "bottom bottom";
                            },
                            scrub: 1.5,
                            invalidateOnRefresh: true,
                        },
                    });
                }

                // Campaign Cards Animation
                const campaignContainers = document.querySelectorAll(
                    ".campaign-container",
                );

                campaignContainers.forEach((container, index) => {
                    const card = container.querySelector(".campaign-card");
                    if (!card) return;

                    gsap.to(card, {
                        rotate: 0,
                        ease: "none",
                        scrollTrigger: {
                            trigger: container,
                            start: "top bottom",
                            end: "top 20%",
                            scrub: true,
                        },
                    });

                    if (index !== campaignContainers.length - 1) {
                        ScrollTrigger.create({
                            trigger: container,
                            start: "bottom bottom",
                            end: "bottom top",
                            pin: true,
                            pinSpacing: false,
                        });
                    }
                });
            }

            // Execute logic when ready
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", initAnimations);
            } else {
                initAnimations();
            }
        </script>
    </body>
</html>
